# Copiá este archivo a .env y ajustá los valores. .env nunca se commitea.

# --- Postgres (docker-compose) ---
POSTGRES_USER=lisogen
POSTGRES_PASSWORD=lisogen
POSTGRES_DB=lisogen

# --- API ---
# Fuera de Docker (tests, alembic local) la API usa esta URL; dentro de compose se arma sola.
DATABASE_URL=postgresql+asyncpg://lisogen:lisogen@localhost:5432/lisogen
# Generá uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-en-produccion-con-32-bytes-o-mas
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# --- Integraciones externas ---
# Cada integración tiene su propio modo: mock (simulada, sin red) o api (servicio real).
INTEGRACIONES_MODO=mock

# --- Bioinformática (Apigen, módulo 5) ---
APIGEN_MODO=mock
APIGEN_API_URL=https://edmrjmfjklwgazzztjcl.supabase.co/rest/v1
APIGEN_API_KEY=

# --- Cupones (API de Exoma Care) ---
CUPONES_MODO=mock
CUPONES_API_URL=https://vekuhonbpqtzakqbcoph.supabase.co/functions/v1/cupones-api
# La clave es del grupo: ponela sólo en tu .env (que no se sube), nunca acá.
CUPONES_API_KEY=

# --- Familiograma (API del Laboratorio) ---
# mock: SVG simple, sin red | api: API real (requiere clave)
FAMILIOGRAMA_MODO=mock
FAMILIOGRAMA_API_URL=https://cnylfdemauswqeqmvwmz.supabase.co/functions/v1/familiograma
# La clave del grupo va únicamente en tu .env, nunca acá.
FAMILIOGRAMA_API_KEY=

# --- Chatbot (GenLab, módulo 8) ---
CHATBOT_MODO=mock
CHATBOT_URL=https://vglzngsrbyagquqqmakf.supabase.co/functions/v1/chat
# La clave publishable y el token van sólo en tu .env (que no se sube), nunca acá.
CHATBOT_APIKEY=
CHATBOT_TOKEN=

# --- FedEx (API de retiros) ---
# Con api, URL, usuario y contraseña son obligatorios; las credenciales del grupo van sólo en tu .env.
FEDEX_MODO=mock
FEDEX_API_URL=https://blcecvxqrkvotawkunxk.supabase.co/functions/v1/fedex
FEDEX_USUARIO=
FEDEX_PASSWORD=
FEDEX_LUGAR_RETIRO=La Plata, Buenos Aires

# --- Mail ---
# smtp: Mailpit local | api: API de Notificaciones | memoria: sólo para tests
MAIL_MODO=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Sólo con MAIL_MODO=api. La clave va únicamente en tu .env.
MAIL_API_URL=
MAIL_API_KEY=

# --- Optimización de rutas ---
# mock: orden por distancia, sin red | api: API de optimización del otro grupo
RUTAS_MODO=mock
LAB_CENTRAL_LAT=-34.919223
LAB_CENTRAL_LON=-57.942838

# --- Archivos (MinIO privado) ---
STORAGE_MODO=minio
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lisogen
MINIO_SECRET_KEY=lisogen-secret
MINIO_BUCKET=lisogen-privado

# --- Seguridad ---
VERIFICAR_DISPOSITIVO=true
# --- Obras sociales ---
# mock: simulado | api: API real de obras sociales (requiere clave)
OBRAS_SOCIALES_MODO=mock
OBRAS_SOCIALES_API_URL=https://bxsvmfesrtjrqubblgws.supabase.co/functions/v1/api
# La clave va únicamente en tu .env.
OBRAS_SOCIALES_API_KEY=

# --- SNOMED CT ---
# cache: sólo base local | api: sugerencias de la API de terminología (requiere clave)
SNOMED_MODO=cache
SNOMED_API_URL=https://hwmpslajqivdqeaylhdc.supabase.co/functions/v1/terminologia/sintomas
# La clave va únicamente en tu .env.
SNOMED_API_KEY=
